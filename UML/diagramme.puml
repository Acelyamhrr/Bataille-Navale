@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
hide enum methods

' Configuration de la mise en page
skinparam packageStyle rectangle
skinparam linetype ortho

' Espacement et taille
skinparam defaultFontSize 11
skinparam classAttributeFontSize 10
skinparam packageFontSize 12
skinparam packageFontStyle bold

' Espacement entre les packages
'top to bottom direction
left to right direction

package model {

    package players {

        class Player {

            + play(weapon : Weapon, position : Position)
        }
    }

    package enums {

        enum TypeResult <<enumeration>> {
            FAILURE
            ATTACKED
            SUNK
            ISLAND
            TRAP
            SONAR_INFO
        }

    }

    package contents {

        package weapons {

            abstract class Weapon <<abstract>> implements model.contents.Content {
                + {abstract} use(grid : Grid, position : Position) : ResultAttack

            }

            class Missile extends Weapon {
                + use(grid : Grid, position : Position) : ResultAttack
            }

            class Bomb extends Weapon {
                + use(grid : Grid, position : Position) : ResultAttack
            }

            class Sonar extends Weapon {
                + use(grid : Grid, position : Position) : ResultAttack
            }
        }

        package traps {

            abstract class Trap <<abstract>> implements model.contents.Content {
                + {abstract} trigger(assaillant : Player, defender : Player, c : Square) : Position
            }

            class BlackHole extends Trap {
                + trigger(assaillant : Player, defender : Player, c : Square) : Position
            }
        }
    }


    package grid {
        class Square {
            - attacked : Boolean
            - inIsland : Boolean

            + <<create>> Square(position : Position, island : Boolean)
            + isEmpty() : Boolean
            + attack(weapon : Weapon) : ResultAttack
            + getContent() : Content
            + setContent(content : Content)
            + wasAttacked() : Boolean
            + getPosition() : Position
        }

        class Grid {
            - size : Integer

            + <<create>> Grid(size : Integer, mode : ModeGame)
            + placeBoat(b : Boat, position : Position)
            + placeTrap(t : Trap, position : Position)
            + attack(position : Position, weapon : Weapon) : ResultAttack
            + reset()
        }

        class Island {
            - position : Integer[*]
            - size : Integer

            + <<create>> Island(x : Integer, y : Integer, size : Integer, squares : Squares[*])
            + contains(s : Square) : Boolean
        }
    }

    package game {

        class History {
            + <<create>> History()
            + addAction(action : Action)
            + getLast() : Action
            + reset()
        }

        class Action {
            - round : Integer

            + <<create>> Action(round : Integer, position : Position, player : Player, weapon : Weapon, result : ResultAttack)
        }

        class ResultAttack {
            - message : String

            + <<create>> ResultAttack(type : TypeResult, message : String)
            + getMessage() : String
            + getType() : TypeResult
        }

        class GameConfig {
            - gridSize : Integer
            - username : String
            - numberBoat : Integer[*]

            + <<create>> GameConfig(mode : ModeGame, gridSize : Integer, robotMode : RobotMode, numberBoat : Integer[*], username : String, trapPlacement : TrapPlacement)
        }
    }

}

package controller {
    class GameController {
        + <<create>> GameController()
        - configureGame() : GameConfig
        - placementGame() : GamePlacement
    }
}


model.grid.Grid o-> "1..*\n- squares" model.grid.Square : > contains
model.grid.Grid o-> "1\n- island" model.grid.Island : > contains
model.grid.Grid o-> "1\n- mode" model.enums.ModeGame : > plays
model.grid.Island *-> "1..*\n- squares" model.grid.Square : > contains
model.grid.Square *-> "1\n- content" model.contents.Content : > contains
model.grid.Square o-> "1\n- position" model.grid.Position : > is located
'model.grid.Square o-> "1\n- islandState" model.enums.State : > is
model.game.History o-> "1..*\n- actions" model.game.Action : > has
model.game.Action o-> "1\n- position" model.grid.Position : > localisation
model.game.Action *-> "1\n- player" model.players.Player
model.game.Action *-> "1\n- weapon" model.contents.weapons.Weapon : > done with
model.game.Action o-> "1\n- result" model.game.ResultAttack : > results
'model.game.ResultAttack o-> "1\n- type" model.enums.TypeResult : > is
model o-> "1\n- name" model.enums : > is

model.players.Player ..> model.grid.Square : > <<uses>>
model.contents.weapons.Weapon ..> model.grid.Grid : > <<uses>>
model.contents.traps.Trap ..> model.players.Player : > <<uses>>
model.contents.traps.Trap ..> model.grid.Square : > <<uses>>
model.grid.Square ..> model.contents.weapons.Weapon : > <<uses>>
model.grid.Grid ..> model.contents.fleet.Boat : > <<uses>>
model.grid.Grid .. model.enums.Orientation : > <<uses>>
model.grid.Grid ..> model.contents.weapons.Weapon : > <<uses>>

controller.GameController o-> "1\n- currentGame" model.game.Game : > has

model.game.GameConfig o-> "1\n- modeGame" model.enums.ModeGame : > has
model.game.GameConfig o-> "1\n- robotMode" model.enums.RobotMode : > has
model.game.GameConfig o-> "1\n- trapPlacement" model.enums.TrapPlacement : > has

@enduml