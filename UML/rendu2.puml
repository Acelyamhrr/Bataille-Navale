        - handleIslandSearch(target : Position)
        - handleTrapPlacement(target : Position, isPlayerGrid : Boolean)

        + startPlacingTrapFromInventory(trapType : TrapType)
        + cancelTrapPlacement()
        - exitTrapPlacementMode()

        - endPlayerTurn()
        - displayPlayerTurnResult(result : TurnResult)
        - displayIslandSearchResult(result : TurnResult)
        - displayRobotTurnResult(result : TurnResult)
        - updateAllDisplays()
        - updateWeaponsDisplay()
        + updatePlayerStatsDisplay()
        + updateRobotStatsDisplay()
        - endGame()

        + isInIsland(x : Integer, y : Integer) : Boolean
        + hasIsland() : Boolean
        + getNumberBoats() : Integer
        + getNumberBoatSquares() : Integer
        + getPlayer() : Player
        + getRobot() : Player
